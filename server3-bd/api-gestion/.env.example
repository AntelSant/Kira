# ============================================
# Servidor 3 - Base de Datos y API de Gestión (Kira)
# ============================================

# Host y puerto en el que se levanta este servidor
SERVER3_HOST=0.0.0.0
SERVER3_PORT=8003

# Clave secreta para comunicación M2M entre componentes de Kira
API_KEY=kira_default_secret_key

# URL de conexión a PostgreSQL
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
DATABASE_URL=postgresql://<usuario>:<contraseña>@localhost:5432/uas_ai_db

# Tiempo de expiración del JWT para la sesión web (en minutos)
# 3 minutos por defecto para pruebas. Cambiar a 300 (5 horas) o más para producción.
JWT_EXPIRE_MINUTES=15

# Clave de cifrado AES-256 para embeddings faciales biométricos
# GENERAR UNA CLAVE ÚNICA: python -c "from crypto_utils import generar_clave; print(generar_clave())"
# NUNCA compartir ni subir al repositorio
EMBEDDING_ENCRYPTION_KEY=xmcfdIhnbfP7XUfzXzYD+G9D++Fn+B6i5RS0i+oEqRo=

# ============================================
# Smart Alerts - Deserción Escolar
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM=kira-alertas@tudominio.com

# Hora de ejecución del chequeo de alertas (formato HH:MM, 24h)
ALERTA_HORA_EJECUCION=22:00

# Mínimo de faltas consecutivas para disparar alerta
ALERTA_MIN_FALTAS=4
