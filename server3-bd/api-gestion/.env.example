# ============================================
# Servidor 3 - Base de Datos y API de Gestión (Kira)
# ============================================

# Host y puerto en el que se levanta este servidor
SERVER3_HOST=0.0.0.0
SERVER3_PORT=8003

# URL del Servidor 1 (Reconocimiento Facial) — usado para callbacks internos
SERVER1_URL=http://127.0.0.1:8001

# Clave secreta para comunicación M2M entre componentes de Kira
# ⚠️ OBLIGATORIO: cambia este valor antes de poner en producción
API_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA

# URL de conexión a PostgreSQL
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>
# ⚠️ OBLIGATORIO: especifica tus credenciales reales de PostgreSQL
DATABASE_URL=postgresql://<usuario>:<contraseña>@localhost:5432/uas_ai_db

# Tiempo de expiración del JWT para la sesión web (en minutos)
# 15 min para desarrollo, 300 (5 horas) o más para producción
JWT_EXPIRE_MINUTES=15

# Clave secreta para firmar los tokens JWT
# ⚠️ OBLIGATORIO: genera una clave única con:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CAMBIAR_POR_UNA_CLAVE_JWT_SEGURA

# Clave de cifrado AES-256 para embeddings faciales biométricos
# ⚠️ OBLIGATORIO: genera una clave única con:
#   python -c "from crypto_utils import generar_clave; print(generar_clave())"
# NUNCA compartas ni subas este valor al repositorio
EMBEDDING_ENCRYPTION_KEY=CAMBIAR_POR_CLAVE_AES256_EN_BASE64

# ============================================
# Smart Alerts - Deserción Escolar
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Cuenta Gmail (o la de tu proveedor) desde la que se envían alertas
SMTP_USER=tu_correo@gmail.com
# Contraseña de aplicación (en Gmail: Configuración > Seguridad > App Passwords)
SMTP_PASSWORD=tu_app_password_aqui
SMTP_FROM=kira-alertas@tudominio.com

# Hora de ejecución del chequeo de alertas (formato HH:MM, 24h)
ALERTA_HORA_EJECUCION=22:00

# Mínimo de faltas consecutivas para disparar alerta
ALERTA_MIN_FALTAS=4
