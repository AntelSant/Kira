# ============================================
# Servidor 1 - Reconocimiento Facial (Kira)
# ============================================

# Host y puerto en el que se levanta este servidor
SERVER1_HOST=0.0.0.0
SERVER1_PORT=8001

# URL del Servidor 3 (API de Gestión / Base de datos)
# ⚠️ OBLIGATORIO: ajusta la IP/host si los servidores están en máquinas distintas
SERVER3_URL=http://<IP_SERVIDOR_3>:8003

# URL del Servidor 2 (Análisis de Emociones)
# ⚠️ OBLIGATORIO: ajusta la IP/host si los servidores están en máquinas distintas
SERVER2_URL=http://<IP_SERVIDOR_2>:8002

# Clave secreta para comunicación M2M entre componentes de Kira
# ⚠️ OBLIGATORIO: debe ser igual en server1, server2, server3 y el firmware
API_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Dispositivo de procesamiento de IA (cuda:0 para GPU, cpu para procesador)
CUDA_DEVICE=cuda:0

# Anti-Spoofing (Detección de vida)
ANTISPOOF_ENABLED=true
ANTISPOOF_THRESHOLD=0.80

# Limpiador de basura - tiempo máximo en minutos para retener rostros en caras_recortadas/
CLEANUP_MAX_AGE_MINUTES=10
