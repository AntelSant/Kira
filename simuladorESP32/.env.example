# ============================================
# Simulador Web ESP32 (Kira)
# ============================================

# URL del Servidor 1 (Endpoint de captura facial)
# ⚠️ OBLIGATORIO: ajusta si server1-face corre en otra IP/puerto
SERVER_URL=http://127.0.0.1:8001/api/capture

# Clave secreta para comunicación M2M entre componentes de Kira
# ⚠️ OBLIGATORIO: debe ser igual al API_KEY de server1-face
API_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA

# Puerto del simulador
SIMULADOR_PORT=8080
