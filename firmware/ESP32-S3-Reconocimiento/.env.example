# ──────────────────────────────────────────────────────────────────────────────
# Kira Firmware — Variables de entorno del dispositivo ESP32-S3
# Copia este archivo como ".env" y ajusta los valores a tu entorno.
#
#   cp .env.example .env
#
# ⚠️  NUNCA subas .env al repositorio (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────────────────────

# ── Red WiFi ──────────────────────────────────────────────────────────────────
# SSID y contraseña de la red a la que se conecta el ESP32.
# Solo soporta redes 2.4 GHz.
WIFI_SSID=MiRedWiFi
WIFI_PASSWORD=MiContraseñaSegura

# ── Servidor Kira (Server 1 — Reconocimiento Facial) ──────────────────────────
# URL completa del endpoint de captura. Debe ser accesible desde la red WiFi.
# Formato: http://<IP>:<PUERTO>/api/capture
SERVER_URL=http://192.168.1.100:8001/api/capture

# ── Autenticación M2M ─────────────────────────────────────────────────────────
# Clave API compartida entre el ESP32 y el backend.
# Debe coincidir con M2M_API_KEY en el .env del server1-face.
API_KEY=kira_default_secret_key

# ── Identificador de Aula ─────────────────────────────────────────────────────
# ID del aula donde está físicamente instalado este dispositivo.
# Debe coincidir con un aula registrada en la base de datos.
AULA_ID=1

# ── Comportamiento del dispositivo ────────────────────────────────────────────
# Segundos de cuenta regresiva antes de capturar la foto.
# Rango recomendado: 3–10. Valor por defecto: 5.
COUNTDOWN_SEC=5

# Tiempo de espera (ms) antes de volver a tomar captura tras resultado negativo
RETRY_NEGATIVO_MS=8000

# Tiempo de espera (ms) antes de volver a tomar captura tras resultado positivo
RETRY_POSITIVO_MS=3000
